# Service
SERVICE_NAME=gateway-service
SERVICE_PORT=8000
LOG_LEVEL=INFO

# Internal service routing
PROFILE_SERVICE_URL=http://profile-service:8080

# Cognito (required in production, not needed when LOCAL_AUTH_BYPASS=true)
COGNITO_CLIENT_ID=
JWKS_URL=

# Local development auth bypass
# Set to true to skip JWT verification and use the LOCAL_USER_* values below.
# Never enable this in production.
LOCAL_AUTH_BYPASS=true
LOCAL_USER_SUB=local-user-sub
LOCAL_USER_EMAIL=local@example.com
LOCAL_USER_ISSUER=http://local-cognito
