# cv-match AWS dev environment variables
#
# Copy to .env.dev and adjust values:
#   cp .env.dev.example .env.dev
#
# NOTE: scripts/dev.sh reads only APP_NAME, STAGE, AWS_REGION, RUN_DB_BOOTSTRAP.

# Core identifiers
APP_NAME=cv-match
STAGE=dev
AWS_REGION=us-east-1


# Optional values used by other support scripts (not read by scripts/dev.sh)
LOCAL_FRONTEND_BASE_URL=http://localhost:3000
