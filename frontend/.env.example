# Copy this file to .env.local and fill in your values.
#
#   cp .env.example .env.local
#
# Purpose: connects your LOCAL frontend (localhost:3000) to your LOCAL backend (localhost:8000).
#
# For connecting your local frontend to the AWS dev backend instead, use .env.dev ?
# that file is auto-generated by the deploy script; do not create it manually.

# Base URL of your API Gateway running locally.
API_GATEWAY_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_GATEWAY_BASE_URL=/api/gateway

# AWS Cognito Hosted UI settings.
# Find these in: AWS Console -> Cognito -> User Pools -> <your pool> -> App integration.
AUTH_AUTHORIZATION_ENDPOINT=https://<your-domain>.auth.<region>.amazoncognito.com/oauth2/authorize
AUTH_TOKEN_ENDPOINT=https://<your-domain>.auth.<region>.amazoncognito.com/oauth2/token
AUTH_LOGOUT_ENDPOINT=https://<your-domain>.auth.<region>.amazoncognito.com/logout

# Cognito expects the logout redirect under the "logout_uri" query param.
AUTH_LOGOUT_REDIRECT_PARAM=logout_uri

# App Client ID ? Cognito -> User Pools -> App clients -> App client id.
AUTH_CLIENT_ID=<your-cognito-app-client-id>

# Must match the callback URL configured in the Cognito App Client.
AUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Must match the logout URL configured in the Cognito App Client.
AUTH_LOGOUT_REDIRECT_URI=http://localhost:3000

# Standard OIDC scopes.
AUTH_SCOPES=openid email profile
